// niri compositor config. Hot-reloads on save.
// Docs: https://niri-wm.github.io/niri/Configuration:-Introduction
// Noctalia integration: https://docs.noctalia.dev/noctalia/compositor-settings/niri/

spawn-at-startup "noctalia"

// Advertise KDE 6 as a fallback desktop so apps that pick their keyring backend
// from XDG_CURRENT_DESKTOP (Chromium, Electron, QtKeychain, python-keyring, etc.)
// select kwallet6 instead of falling back to basic_text. Also opt Chromium and
// Electron apps into native Wayland (NIXOS_OZONE_WL) so they get crisp
// per-monitor fractional scaling instead of falling back to Xwayland. Niri's
// `environment` block only applies to spawned processes (not systemd --user),
// so xdg-desktop-portal and systemd services still see XDG_CURRENT_DESKTOP=niri.
environment {
    XDG_CURRENT_DESKTOP "niri:KDE"
    KDE_SESSION_VERSION "6"
    NIXOS_OZONE_WL "1"
}

// The "Important Hotkeys" overlay now pops up at session start (Mod+F1
// reopens it). Uncomment the line below to suppress the startup pop-up.
hotkey-overlay {
    // skip-at-startup
}

input {
    keyboard {
        xkb {
            layout "de"
            variant "nodeadkeys"
        }
    }
}

// Tighter than niri's defaults (gaps 16, focus-ring width 4). The `border`
// block is off by default; the visible ring around windows is the focus ring.
layout {
    gaps 8

    focus-ring {
        width 2
    }
}

// Display layout, copied from KDE's kwinoutputconfig.json: Samsung 1080p on the
// left, Dell 4K in the middle (1.7x, 240 Hz, primary), AOC 1080p rotated upright
// on the right. Positions are logical (scaled) pixels and must stay adjacent —
// the cursor only crosses between touching outputs. niri replaces an output's
// position if it would overlap another one.
output "DP-6" {
    mode "3840x2160@239.991"
    scale 1.7
    position x=1920 y=376
    focus-at-startup
    // KDE has VRR "Automatic"; on-demand only engages it for windows matching
    // the variable-refresh-rate window rule.
    // variable-refresh-rate on-demand=true
}

output "HDMI-A-2" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=552
}

output "DP-4" {
    mode "1920x1080@60.000"
    scale 1
    transform "90"
    position x=4179 y=50

    // Upright output: windows stack as full-width rows instead of half-width
    // columns. Consume a neighbour into the column (Mod+Comma/Period) to split.
    layout {
        default-column-width { proportion 1.0; }
        preset-column-widths {
            proportion 1.0
            proportion 0.5
        }
        preset-window-heights {
            proportion 0.5
            proportion 0.33333
        }
    }
}

// IMPORTANT: niri does not fill in the default keybindings. Most sections get
// their defaults when omitted, but `binds` does not — whatever is listed here
// is the complete set of binds.
//
// Modifier scheme (tailored for German ISO QWERTZ / `de` `nodeadkeys`):
//   Mod            -> focus & primary actions
//   Mod+Shift      -> move / rearrange windows, columns & workspaces
//   Mod+Alt        -> resize (home-row width/height & sizing presets)
//   Mod+Ctrl       -> monitors (Mod+Ctrl+Shift moves columns across monitors)
binds {
    // Shows the "Important Hotkeys" overlay.
    Mod+F1 { show-hotkey-overlay; }

    // Programs & Noctalia panels.
    Mod+Return hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }
    Mod+Space hotkey-overlay-title="Run an Application: noctalia launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+Space hotkey-overlay-title="Toggle Input Method: fcitx5" { spawn "fcitx5-remote" "-t"; }
    Mod+D hotkey-overlay-title="Noctalia control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+asciicircum hotkey-overlay-title="Noctalia clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+S hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Shift+Escape allow-inhibiting=false hotkey-overlay-title="Lock the Screen: noctalia" { spawn "noctalia" "msg" "session" "lock"; }
    // Screen reader toggle (orca is installed). Keep as in the default config.
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Volume/brightness/media through Noctalia so its OSDs are used.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    // Window switcher (Noctalia's, instead of niri's built-in Alt+Tab-less setup).
    Alt+Tab       { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Alt+Shift+Tab { spawn "noctalia" "msg" "window-switcher" "hold" "reverse"; }

    // Overview, workspace ping-pong (< key next to Left Shift), and close.
    Mod+Tab repeat=false { toggle-overview; }
    Mod+less { focus-workspace-previous; }
    Mod+Q repeat=false { close-window; }

    // Focus: seamless 2D navigation across columns, stacked windows, and workspaces.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    // Move columns and windows (crosses workspace boundaries vertically).
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Fine resize on home row (replaces split Minus/Plus on German QWERTZ).
    Mod+Alt+Left  { set-column-width "-10%"; }
    Mod+Alt+Right { set-column-width "+10%"; }
    Mod+Alt+Up    { set-window-height "-10%"; }
    Mod+Alt+Down  { set-window-height "+10%"; }
    Mod+Alt+H     { set-column-width "-10%"; }
    Mod+Alt+L     { set-column-width "+10%"; }
    Mod+Alt+K     { set-window-height "-10%"; }
    Mod+Alt+J     { set-window-height "+10%"; }

    // Monitors.
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+H     { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J     { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K     { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L     { move-column-to-monitor-right; }

    // Direct workspace navigation & column moves (skips stacked windows).
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+U               { focus-workspace-down; }
    Mod+I               { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+U         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }

    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }
    Mod+Ctrl+U         { move-workspace-down; }
    Mod+Ctrl+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Move the focused window in and out of a column (replaces AltGr-gated [/] on DE).
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // Column width/height presets.
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Alt+R   { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Alt+F   { expand-column-to-available-width; }
    Mod+M       { maximize-window-to-edges; }

    Mod+C       { center-column; }
    Mod+Shift+C { center-visible-columns; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+T { toggle-column-tabbed-display; }

    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Escape hatch in case an app grabs all shortcuts (remote desktop etc.).
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Quit (shows a confirmation dialog) and power off the monitors.
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}

// Rounded corners on all windows.
window-rule {
    geometry-corner-radius 1
    clip-to-geometry true
}

// Noctalia's settings toplevel: floating, sized like the docs suggest.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Blurred wallpaper copy inside niri's overview (needs [backdrop] in noctalia's config).
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// Lets Noctalia notifications activate windows.
debug {
    honor-xdg-activation-with-invalid-serial
}
