{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "agentMode": "auto",
  "allowNonWorkspaceAccess": true,
  "editorMode": "vim",
  "enableTerminalSandbox": false,
  "model": "Gemini 4 Hydrogen (Medium)",
  "permissions": {
    "allow": [
      "read_file(*)"
    ],
    "deny": [
      "read_file(/home/finn/.ssh)",
      "read_file(/home/finn/.hermes/.env)"
    ]
  },
  "trustedWorkspaces": [
    "/home/finn"
  ]
}
