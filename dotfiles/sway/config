# Sway session, mirroring dotfiles/niri/config.kdl where sway has an equivalent.
# Scrolling tiling is not a sway layout: Mod+Shift+Y starts papersway (PaperWM
# semantics over sway's IPC) and rebinds navigation to it; the same binding
# leaves the mode and stops the daemon.

set $mod Mod4
set $term ghostty
set $shotdir ~/Pictures/Screenshots

# Display layout copied from niri: Samsung 1080p on the left, Dell 4K in the
# middle (1.7x, 240 Hz, HDR), AOC 1080p rotated upright on the right. Positions
# are physical pixels here, not logical ones.
#
# `hdr on` needs the Vulkan renderer, which modules/sway.nix exports as
# WLR_RENDERER. Fractional 1.7 is honoured but blurry for Xwayland clients
# (man 5 sway-output): use scale 2 there if that bothers you.
output "HDMI-A-2" mode 1920x1080@60Hz position 0 0 scale 1
output "DP-6" mode 3840x2160@239.991Hz position 1920 0 scale 1.7 hdr on render_bit_depth 10
output "DP-4" mode 1920x1080@60Hz position 5760 0 scale 1 transform 90

input "type:keyboard" {
    xkb_layout de
    xkb_variant nodeadkeys
}

# papersway expects these; they are also the sane defaults for a horizontal strip.
focus_wrapping no
default_orientation horizontal

# niri uses gaps 8 with no gap around a lone column; smart_gaps reproduces that.
gaps inner 8
smart_gaps on
default_border pixel 2
default_floating_border pixel 2

### programs ##################################################################

exec noctalia

### programs & panels ##########################################################

bindsym $mod+Return exec $term
bindsym $mod+Space exec noctalia msg panel-toggle launcher
bindsym $mod+d exec noctalia msg panel-toggle control-center
bindsym $mod+s exec noctalia msg settings-toggle
bindsym $mod+Shift+space exec fcitx5-remote -t
bindsym $mod+Shift+e exec noctalia msg session lock

# Volume, brightness and media through Noctalia so its OSDs are used.
bindsym --locked XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym --locked XF86AudioLowerVolume exec noctalia msg volume-down
bindsym --locked XF86AudioMute exec noctalia msg volume-mute
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec noctalia msg brightness-up
bindsym --locked XF86MonBrightnessDown exec noctalia msg brightness-down
bindsym --locked XF86AudioPlay exec noctalia msg media toggle
bindsym --locked XF86AudioPrev exec noctalia msg media previous
bindsym --locked XF86AudioNext exec noctalia msg media next

### windows ###################################################################

bindsym $mod+q kill
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resize (niri's Mod+Alt+-10% steps, mapped onto sway's resize mode).
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 20 px
    bindsym Right resize grow width 20 px
    bindsym Up resize shrink height 20 px
    bindsym Down resize grow height 20 px
    bindsym h resize shrink width 20 px
    bindsym l resize grow width 20 px
    bindsym k resize shrink height 20 px
    bindsym j resize grow height 20 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+Shift+v focus mode_toggle
bindsym $mod+t layout toggle tabbed splith

### monitors ##################################################################

bindsym $mod+ctrl+Left focus output left
bindsym $mod+ctrl+Right focus output right
bindsym $mod+ctrl+Up focus output up
bindsym $mod+ctrl+Down focus output down
bindsym $mod+ctrl+h focus output left
bindsym $mod+ctrl+l focus output right
bindsym $mod+ctrl+k focus output up
bindsym $mod+ctrl+j focus output down

bindsym $mod+ctrl+Shift+Left move container to output left
bindsym $mod+ctrl+Shift+Right move container to output right
bindsym $mod+ctrl+Shift+Up move container to output up
bindsym $mod+ctrl+Shift+Down move container to output down

### workspaces ###############################################################

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+ctrl+Down workspace next
bindsym $mod+ctrl+Up workspace prev

### screenshots ###############################################################

bindsym Print exec sh -c 'f=$HOME/Pictures/Screenshots/$(date +%F_%H%M%S).png; mkdir -p "$(dirname $f)"; grim -g "$(slurp)" "$f" && wl-copy < "$f"'
bindsym Ctrl+Print exec sh -c 'f=$HOME/Pictures/Screenshots/$(date +%F_%H%M%S).png; mkdir -p "$(dirname $f)"; grim "$f" && wl-copy < "$f"'

### games #####################################################################

# Steam hides the real app id behind steam_app_<id>; the Windows Proton process
# reports its exe name on Wayland and its window class on Xwayland.
for_window [app_id="forzahorizon6.exe"] move container to output "DP-6", fullscreen enable
for_window [class="forzahorizon6.exe"] move container to output "DP-6", fullscreen enable

### scrolling mode ############################################################

# papersway gives PaperWM-style scrolling tiling on top of sway: a workspace
# shows N columns and further ones live on the neighbouring paper workspaces,
# which you scroll through instead of resizing windows. It is a daemon driving
# sway over its IPC, so it is started on demand and the navigation keys are
# rebound to `papersway-msg` while the mode is active.
bindsym $mod+Shift+y exec pkill -x papersway, exec papersway, mode "scroll"

mode "scroll" {
    bindsym $mod+Shift+y exec pkill -x papersway, mode "default"
    bindsym Escape exec pkill -x papersway, mode "default"

    # Columns scroll instead of the layout splitting.
    bindsym $mod+Left exec papersway-msg focus left
    bindsym $mod+Right exec papersway-msg focus right
    bindsym $mod+h exec papersway-msg focus left
    bindsym $mod+l exec papersway-msg focus right
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+j focus down
    bindsym $mod+k focus up

    bindsym $mod+Shift+Left exec papersway-msg move left
    bindsym $mod+Shift+Right exec papersway-msg move right
    bindsym $mod+Shift+h exec papersway-msg move left
    bindsym $mod+Shift+l exec papersway-msg move right
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up

    # Width of the focused column, columns per workspace, absorb/expel.
    bindsym $mod+f exec papersway-msg width toggle
    bindsym $mod+minus exec papersway-msg cols decr
    bindsym $mod+equal exec papersway-msg cols incr
    bindsym $mod+comma exec papersway-msg absorb-expel left
    bindsym $mod+period exec papersway-msg absorb-expel right

    # Paper workspaces are the scroll axis; numeric workspace jumps would fight
    # papersway's own naming, so they are replaced by these two.
    bindsym $mod+u exec papersway-msg workspace prev_on_output
    bindsym $mod+i exec papersway-msg workspace next_on_output
    bindsym $mod+Shift+u exec papersway-msg move-to-workspace prev_on_output
    bindsym $mod+Shift+i exec papersway-msg move-to-workspace next_on_output
    bindsym $mod+a exec papersway-msg fresh-workspace
    bindsym $mod+Shift+a exec papersway-msg fresh-workspace take

    bindsym $mod+Return exec $term
    bindsym $mod+Space exec noctalia msg panel-toggle launcher
    bindsym $mod+q kill
    bindsym $mod+Shift+e exec noctalia msg session lock
}

### session ###################################################################

bindsym $mod+Shift+x exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym Ctrl+Alt+Delete exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
