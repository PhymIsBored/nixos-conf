{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "lmstudio": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LM Studio (local)",
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B"
        }
      },
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      }
    },
    "upb": {
      "name": "UPB AI gateway",
      "env": ["UPB_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai-gateway.uni-paderborn.de/v1"
      },
      "models": {
        "openai.gpt-6-astra": {
          "name": "OpenAI GPT 6 Astra"
        },
        "openai.gpt-6.1-sol": {
          "name": "OpenAI GPT 6.1 Sol"
        },
        "openai.gpt-6-luna": {
          "name": "OpenAI GPT 6 Luna"
        },
        "hs-de.qwen3.8-27b": {
          "name": "HS-DE Qwen 3.8"
        },
        "gwdg.glm-5.3-flash": {
          "name": "GWDG GLM 5.3 Flash"
        },
        "gwdg.deepseek-v4-flash-0731": {
          "name": "GWDG Deepseek V4 FLash"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "7z *": "allow",
      "bzip2 *": "allow",
      "cat *": "allow",
      "chmod *": "allow",
      "chown *": "allow",
      "curl *": "allow",
      "date": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dig *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "env": "allow",
      "false": "allow",
      "file *": "allow",
      "find *": "allow",
      "free *": "allow",
      "git *": "ask",
      "git branch *": "allow",
      "git clone *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git remote *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git status *": "allow",
      "git tag *": "allow",
      "gpg *": "allow",
      "grep *": "allow",
      "gunzip *": "allow",
      "gzip *": "allow",
      "head *": "allow",
      "host *": "allow",
      "hostname": "allow",
      "htop": "allow",
      "ifconfig": "allow",
      "ip *": "allow",
      "kill *": "allow",
      "ln *": "allow",
      "ls *": "allow",
      "md5sum *": "allow",
      "mkdir *": "allow",
      "nslookup *": "allow",
      "openssl *": "allow",
      "pgrep *": "allow",
      "ping *": "allow",
      "pip *": "allow",
      "pkill *": "allow",
      "printenv *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "route *": "allow",
      "rsync *": "allow",
      "scp *": "allow",
      "seq *": "allow",
      "sha256sum *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "ssh *": "allow",
      "ssh-keygen *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tar *": "allow",
      "tee *": "allow",
      "timeout *": "allow",
      "top *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "traceroute *": "allow",
      "true": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "unzip *": "allow",
      "uptime": "allow",
      "wc *": "allow",
      "wget *": "allow",
      "which *": "allow", 
      "whoami": "allow",
      "xargs *": "allow",
      "xz *": "allow",
      "yes *": "allow",
      "zip *": "allow",
      "docker info": "allow",
      "docker version": "allow",
      "docker ps *": "allow",
      "docker images *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker network ls": "allow",
      "docker volume ls": "allow",
      "docker stats *": "allow",
      "docker top *": "allow",
      "docker port *": "allow",
      "docker events": "allow",
      "docker config ls": "allow",
      "docker secret ls": "allow",
      "docker service ls": "allow",
      "docker node ls": "allow",
      "docker plugin ls": "allow",
      "docker buildx ls": "allow",
      "docker context ls": "allow"
    },
    "task": "allow",
    "external_directory": {
      "~/": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": "allow",
    "websearch": "allow"
  }
}
