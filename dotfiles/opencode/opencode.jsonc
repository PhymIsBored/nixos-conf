{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "lmstudio": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LM Studio (local)",
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B"
        }
      },
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      }
    },
    "upb": {
      "name": "UPB AI gateway",
      "env": ["UPB_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai-gateway.uni-paderborn.de/v1"
      },
      "models": {
        "anthropic.claude-opus-5-5": {
          "name": "Claude Opus 5.5"
        },
        "anthropic.claude-haiku-5-5": {
          "name": "Claude Haiku 5.5"
        },
        "openai.gpt-6-astra": {
          "name": "OpenAI GPT 6 Astra"
        },
        "openai.gpt-6.1-sol": {
          "name": "OpenAI GPT 6.1 Sol"
        },
        "openai.gpt-6.1-terra": {
          "name": "OpenAI GPT 6.1 Terra"
        },
        "openai.gpt-6-luna": {
          "name": "OpenAI GPT 6 Luna"
        },
        "hs-de.qwen3.8-27b": {
          "name": "HS-DE Qwen 3.8"
        },
        "gwdg.glm-5.3-flash": {
          "name": "GWDG GLM 5.3 Flash"
        },
        "gwdg.glm-5.3": {
          "name": "GWDG GLM 5.3"
        },
        "gwdg.mistral-large-4-1t-a52b": {
          "name": "Mistral Large 4"
        },
        "gwdg.deepseek-v4.1-flash-1017": {
          "name": "DeepSeek v4.1-flash"
        }
      }
    }
  },
  "permissions": [
    // Shell permissions
    { "action": "shell", "resource": "free *", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "7z *", "effect": "allow" },
    { "action": "shell", "resource": "bzip2 *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "chmod *", "effect": "allow" },
    { "action": "shell", "resource": "chown *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "date", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "dig *", "effect": "allow" },
    { "action": "shell", "resource": "docker buildx ls", "effect": "allow" },
    { "action": "shell", "resource": "docker config ls", "effect": "allow" },
    { "action": "shell", "resource": "docker context ls", "effect": "allow" },
    { "action": "shell", "resource": "docker events", "effect": "allow" },
    { "action": "shell", "resource": "docker images *", "effect": "allow" },
    { "action": "shell", "resource": "docker info", "effect": "allow" },
    { "action": "shell", "resource": "docker inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker network ls", "effect": "allow" },
    { "action": "shell", "resource": "docker node ls", "effect": "allow" },
    { "action": "shell", "resource": "docker plugin ls", "effect": "allow" },
    { "action": "shell", "resource": "docker port *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker secret ls", "effect": "allow" },
    { "action": "shell", "resource": "docker service ls", "effect": "allow" },
    { "action": "shell", "resource": "docker stats *", "effect": "allow" },
    { "action": "shell", "resource": "docker top *", "effect": "allow" },
    { "action": "shell", "resource": "docker version", "effect": "allow" },
    { "action": "shell", "resource": "docker volume ls", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "env", "effect": "allow" },
    { "action": "shell", "resource": "false", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git clone *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git remote *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git tag *", "effect": "allow" },
    { "action": "shell", "resource": "gpg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "gunzip *", "effect": "allow" },
    { "action": "shell", "resource": "gzip *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "host *", "effect": "allow" },
    { "action": "shell", "resource": "hostname", "effect": "allow" },
    { "action": "shell", "resource": "htop", "effect": "allow" },
    { "action": "shell", "resource": "ifconfig", "effect": "allow" },
    { "action": "shell", "resource": "ip *", "effect": "allow" },
    { "action": "shell", "resource": "kill *", "effect": "allow" },
    { "action": "shell", "resource": "ln *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "md5sum *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "nixfmt *", "effect": "allow" },
    { "action": "shell", "resource": "nslookup *", "effect": "allow" },
    { "action": "shell", "resource": "openssl *", "effect": "allow" },
    { "action": "shell", "resource": "pgrep *", "effect": "allow" },
    { "action": "shell", "resource": "ping *", "effect": "allow" },
    { "action": "shell", "resource": "pip *", "effect": "allow" },
    { "action": "shell", "resource": "pkill *", "effect": "allow" },
    { "action": "shell", "resource": "printenv *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "route *", "effect": "allow" },
    { "action": "shell", "resource": "rsync *", "effect": "allow" },
    { "action": "shell", "resource": "scp *", "effect": "allow" },
    { "action": "shell", "resource": "seq *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "shell", "resource": "sleep *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "ssh *", "effect": "allow" },
    { "action": "shell", "resource": "ssh-keygen *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tar *", "effect": "allow" },
    { "action": "shell", "resource": "tee *", "effect": "allow" },
    { "action": "shell", "resource": "timeout *", "effect": "allow" },
    { "action": "shell", "resource": "top *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "traceroute *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "unzip *", "effect": "allow" },
    { "action": "shell", "resource": "uptime", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "wget *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "xargs *", "effect": "allow" },
    { "action": "shell", "resource": "xz *", "effect": "allow" },
    { "action": "shell", "resource": "yes *", "effect": "allow" },
    { "action": "shell", "resource": "zip *", "effect": "allow" },
    // Subagent permissions
    { "action": "subagent", "resource": "*", "effect": "allow" },
    // File permissions
    { "action": "external_directory", "resource": "~/*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "~/nixos-conf/dotfiles/opencode/*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ]
}
