{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["lmstudio", "openrouter", "openai"],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "model": "qwen/qwen3.6-35b-a3b",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "7z *": "allow",
      "bzip2 *": "allow",
      "cat *": "allow",
      "chmod *": "allow",
      "chown *": "allow",
      "curl *": "allow",
      "date": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dig *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "env": "allow",
      "false": "allow",
      "file *": "allow",
      "find *": "allow",
      "free *": "allow",
      "git *": "ask",
      "git branch": "allow",
      "git clone": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git remote *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git status *": "allow",
      "git tag *": "allow",
      "gpg *": "allow",
      "grep *": "allow",
      "gunzip *": "allow",
      "gzip *": "allow",
      "head *": "allow",
      "host *": "allow",
      "hostname": "allow",
      "htop": "allow",
      "ifconfig": "allow",
      "ip *": "allow",
      "kill *": "allow",
      "ln *": "allow",
      "ls *": "allow",
      "md5sum *": "allow",
      "nslookup *": "allow",
      "openssl *": "allow",
      "pgrep *": "allow",
      "ping *": "allow",
      "pip *": "allow",
      "pkill *": "allow",
      "printenv *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "route *": "allow",
      "rsync *": "allow",
      "scp *": "allow",
      "seq *": "allow",
      "sha256sum *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "ssh *": "allow",
      "ssh-keygen *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tar *": "allow",
      "tee *": "allow",
      "timeout *": "allow",
      "top *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "traceroute *": "allow",
      "true": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "unzip *": "allow",
      "uptime": "allow",
      "wc *": "allow",
      "wget *": "allow",
      "which *": "allow", 
      "whoami": "allow",
      "xargs *": "allow",
      "xz *": "allow",
      "yes *": "allow",
      "zip *": "allow",
      "docker info": "allow",
      "docker version": "allow",
      "docker ps *": "allow",
      "docker images *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker network ls": "allow",
      "docker volume ls": "allow",
      "docker stats *": "allow",
      "docker top *": "allow",
      "docker port *": "allow",
      "docker events": "allow",
      "docker config ls": "allow",
      "docker secret ls": "allow",
      "docker service ls": "allow",
      "docker node ls": "allow",
      "docker plugin ls": "allow",
      "docker buildx ls": "allow",
      "docker context ls": "allow"
    },
    "task": "allow",
    "external_directory": {
      "~/": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": "allow",
    "websearch": "allow"
  }
}
