{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "lmstudio": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LM Studio (local)",
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B"
        }
      },
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      }
    },
    "upb": {
      "name": "UPB AI gateway",
      "env": ["UPB_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai-gateway.uni-paderborn.de/v1"
      },
      "models": {
        "anthropic.claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "anthropic.claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "openai.gpt-6-astra": {
          "name": "OpenAI GPT 6 Astra",
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai.gpt-6.1-sol": {
          "name": "OpenAI GPT 6.1 Sol",
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai.gpt-6.1-terra": {
          "name": "OpenAI GPT 6.1 Terra",
          "limit": { "context": 922000, "output": 128000 }
        },
        "openai.gpt-6-luna": {
          "name": "OpenAI GPT 6 Luna",
          "limit": { "context": 922000, "output": 128000 }
        },
        "hs-de.qwen3.8-27b": {
          "name": "HS-DE Qwen 3.8",
          "limit": { "context": 262000, "output": 262000 }
        },
        "gwdg.glm-5.3-flash": {
          "name": "GWDG GLM 5.3 Flash",
          "limit": { "context": 200000, "output": 200000 }
        },
        "gwdg.glm-5.3": {
          "name": "GWDG GLM 5.3",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "gwdg.mistral-large-4-1t-a52b": {
          "name": "Mistral Large 4",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "gwdg.deepseek-v4.1-flash-1017": {
          "name": "DeepSeek v4.1-flash",
          "limit": { "context": 1000000, "output": 256000 }
        }
      }
    }
  },
  "permissions": [
    // Baseline: allow routine work without prompting (rules are last-match-wins)
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },

    // Deny: secrets & credentials (read)
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "read", "resource": "*.env.dist", "effect": "allow" },
    { "action": "read", "resource": "~/.ssh", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.hermes/.env", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/config", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/sops/age/*", "effect": "deny" },
    { "action": "read", "resource": "/var/lib/sops-nix/*", "effect": "deny" },
    { "action": "read", "resource": "/run/secrets", "effect": "deny" },
    { "action": "read", "resource": "/run/secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },

    // Deny: secrets & credentials (edit)
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.sample", "effect": "allow" },
    { "action": "edit", "resource": "*.env.template", "effect": "allow" },
    { "action": "edit", "resource": "*.env.dist", "effect": "allow" },
    { "action": "edit", "resource": "~/.ssh", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.hermes/.env", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.kube/config", "effect": "deny" },
    { "action": "edit", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/sops/age/*", "effect": "deny" },
    { "action": "edit", "resource": "/var/lib/sops-nix/*", "effect": "deny" },
    { "action": "edit", "resource": "/run/secrets", "effect": "deny" },
    { "action": "edit", "resource": "/run/secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },

    // Deny: secrets & credentials (shell)
    { "action": "shell", "resource": "*.ssh*", "effect": "deny" },
    { "action": "shell", "resource": "*.hermes/.env*", "effect": "deny" },
    { "action": "shell", "resource": "* .env", "effect": "deny" },
    { "action": "shell", "resource": "* .env *", "effect": "deny" },
    { "action": "shell", "resource": "*/.env", "effect": "deny" },
    { "action": "shell", "resource": "*/.env *", "effect": "deny" },
    { "action": "shell", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*.aws/credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*.kube/config*", "effect": "deny" },
    { "action": "shell", "resource": "*.docker/config.json*", "effect": "deny" },
    { "action": "shell", "resource": "*sops/age*", "effect": "deny" },
    { "action": "shell", "resource": "*/var/lib/sops-nix/*", "effect": "deny" },
    { "action": "shell", "resource": "*/run/secrets*", "effect": "deny" },

    // Deny: privilege escalation
    { "action": "shell", "resource": "sudo", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "* sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*&&sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*|sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*;sudo *", "effect": "deny" },
    { "action": "shell", "resource": "doas", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "* doas *", "effect": "deny" },
    { "action": "shell", "resource": "pkexec", "effect": "deny" },
    { "action": "shell", "resource": "pkexec *", "effect": "deny" },
    { "action": "shell", "resource": "* pkexec *", "effect": "deny" },
    { "action": "shell", "resource": "su", "effect": "deny" },
    { "action": "shell", "resource": "su -*", "effect": "deny" },
    { "action": "shell", "resource": "su root*", "effect": "deny" },
    { "action": "shell", "resource": "* su -*", "effect": "deny" },
    { "action": "shell", "resource": "* su root*", "effect": "deny" },

    // Deny: destructive / remote-mutating git (soft/mixed git reset remains allowed)
    { "action": "shell", "resource": "git push", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "* git push", "effect": "deny" },
    { "action": "shell", "resource": "* git push *", "effect": "deny" },
    { "action": "shell", "resource": "*git -C * push", "effect": "deny" },
    { "action": "shell", "resource": "*git -C * push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "* git reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "*git -C * reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "* git clean*", "effect": "deny" },
    { "action": "shell", "resource": "*git -C * clean*", "effect": "deny" },

    // Deny: catastrophic / NixOS active-config mutations (test & dry-run remain allowed)
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "* rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf / *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /?", "effect": "deny" },
    { "action": "shell", "resource": "* rm -rf /?", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf /? *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr /", "effect": "deny" },
    { "action": "shell", "resource": "* rm -fr /", "effect": "deny" },
    { "action": "shell", "resource": "*rm -fr / *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr /?", "effect": "deny" },
    { "action": "shell", "resource": "* rm -fr /?", "effect": "deny" },
    { "action": "shell", "resource": "*rm -fr /? *", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf ~/", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf ~ *", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf ~/?", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf ~/? *", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf /home/finn", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf /home/finn/", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf /home/finn *", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf $HOME", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf $HOME/", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf $HOME *", "effect": "deny" },
    { "action": "shell", "resource": "*mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "*dd *of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "*nixos-rebuild*switch*", "effect": "deny" },
    { "action": "shell", "resource": "*nixos-rebuild*boot*", "effect": "deny" },

    // Ask: agent config self-modification (reading/diffing remains allowed)
    { "action": "edit", "resource": "~/.config/opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "~/nixos-conf/dotfiles/opencode/*", "effect": "ask" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": "*/opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": "~/.gemini/config/*", "effect": "ask" },
    { "action": "edit", "resource": "~/.gemini/antigravity-cli/settings.json", "effect": "ask" },
    { "action": "edit", "resource": "~/nixos-conf/dotfiles/gemini/*", "effect": "ask" },
    { "action": "edit", "resource": "~/.hermes/config.yaml", "effect": "ask" },
    { "action": "edit", "resource": "~/nixos-conf/dotfiles/hermes/*", "effect": "ask" }
  ]
}
