# Profile
export HISTCONTROL=ignoreboth
export MANPAGER='nvim +Man!'
export EDITOR=nvim
export PAGER=less

umask 077 # block those file-permissions per default

# Command completion
bind 'TAB:menu-complete'
# bind -s 'set completion-ignore-case on'

alias ...='cd ../..'
alias ..='cd ..'
alias cp='cp --reflink=auto'
alias diff='git diff --no-index --exit-code'
alias du='du -sh'
alias free='free --human'
alias ffind='find . -type f -name'

alias l.='ls -d .*'
alias la='ls -A'
alias ll='ls -lA'
alias ls='ls --color=auto -hF'

alias mvim='nvim -M'
alias vim='nvim'

alias gdiff='git diff --patience --find-renames \
    --color-moved=zebra \
    --color-moved-ws=allow-indentation-change'

alias clock='clock-rs'
alias hermes='hermes -c' # stop empty sessions from piling up

# Colors for command-substitution prompt output.
# \001 and \002 tell readline these sequences are non-printing.
_prompt_cyan=$'\001\e[36m\002'
_prompt_green=$'\001\e[32m\002'
_prompt_yellow=$'\001\e[33m\002'
_prompt_red=$'\001\e[31m\002'
_prompt_reset=$'\001\e[0m\002'

# custom prompt
_prompt_git() {
  local dot_git ref sha n_ahead n_behind

  dot_git="$(git rev-parse --git-dir 2>/dev/null)" || return

  ref="$(git rev-parse --symbolic-full-name HEAD 2>/dev/null)"
  ref="${ref#refs/heads/}"


  if [ "$ref" = "HEAD" ] || [ -z "$ref" ]; then
    sha="${_prompt_cyan}initial${_prompt_reset}"

    if git rev-parse '@{upstream}' >/dev/null 2>&1; then
      ref="${_prompt_green}main${_prompt_reset}"
    else
      ref="${_prompt_cyan}main${_prompt_reset}"
    fi
  else
    sha="$(git rev-parse --short HEAD 2>/dev/null)"

    if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
      sha="${_prompt_cyan}${sha}${_prompt_reset}"
    elif ! git diff-index --quiet --ignore-submodules --cached HEAD 2>/dev/null; then
      sha="${_prompt_yellow}${sha}${_prompt_reset}"
    elif ! timeout 0.05s git -C "$dot_git/.." diff-index \
      --quiet --ignore-submodules --diff-filter=ad HEAD 2>/dev/null; then
      sha="${_prompt_red}${sha}${_prompt_reset}"
    else
      sha="${_prompt_green}${sha}${_prompt_reset}"
    fi

    if ! git rev-parse '@{upstream}' >/dev/null 2>&1; then
      ref="${_prompt_cyan}${ref}${_prompt_reset}"
    else
      n_ahead="$(git rev-list --count @{upstream}..HEAD 2>/dev/null)"
      n_behind="$(git rev-list --count HEAD..@{upstream} 2>/dev/null)"

      if [ "$n_ahead" -eq 0 ]; then
        if [ "$n_behind" -eq 0 ]; then
          ref="${_prompt_green}${ref}${_prompt_reset}"
        else
          ref="${_prompt_yellow}${ref}-${n_behind}${_prompt_reset}"
        fi
      else
        if [ "$n_behind" -eq 0 ]; then
          ref="${_prompt_yellow}${ref}+${n_ahead}${_prompt_reset}"
        else
          ref="${_prompt_red}${ref}+${n_ahead}-${n_behind}${_prompt_reset}"
        fi
      fi
    fi
  fi

  #printf '%s %s' "$ref" "$sha" # also print the commit-hash
  printf '%s' "$ref"
}

PS1='${_prompt_green}\u@\h ${_prompt_cyan}\w ${_prompt_reset}$(_prompt_git) $ '

